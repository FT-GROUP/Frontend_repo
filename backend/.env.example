# Copia este archivo como ".env" y ajusta los valores.

NODE_ENV=development
PORT=3000

# Opcion A: variables sueltas (comodo en desarrollo local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ft_group

# Opcion B: cadena de conexion completa (si se define, tiene prioridad
# sobre las variables sueltas de arriba). Util para servicios cloud.
# DATABASE_URL=postgresql://usuario:password@host:5432/basededatos
# DATABASE_SSL=true

# Secreto para firmar los JWT. CAMBIAR en produccion por un valor
# largo y aleatorio (por ejemplo: openssl rand -base64 48).
JWT_SECRET=solo-desarrollo-local-cambiar-antes-de-desplegar-1234567890
JWT_EXPIRATION=15m

# Origen(es) permitidos para CORS (usar "*" solo en desarrollo).
CORS_ORIGIN=http://localhost:5173
DB_POOL_MAX=10

# --- Asistente de soporte con IA (opcional) -------------------------------
# Sin IA_API_KEY el modulo queda deshabilitado: /api/asistente responde 503
# y el chat del frontend usa su respaldo de preguntas frecuentes. El resto
# del backend funciona igual, asi que nadie necesita una clave para
# trabajar en los demas modulos.
#
# NUNCA subir la clave al repositorio: el .env esta en .gitignore y debe
# seguir estandolo.
# IA_API_KEY=sk-...

# Proveedor. Por defecto OpenAI. Cualquier servicio compatible con la API
# de Chat Completions funciona cambiando estas dos lineas, por ejemplo con
# Groq:  IA_BASE_URL=https://api.groq.com/openai/v1
#
# El modelo debe soportar llamada a herramientas (tool calling); sin eso el
# agente conversa pero no puede abrir tickets. Para comprobar que modelos
# admite tu cuenta y si el elegido sirve:  node scripts/verificar-ia.js
IA_BASE_URL=https://api.openai.com/v1
IA_MODELO=gpt-6-luna

# Ajustes del modelo. Temperatura baja = respuestas mas predecibles.
IA_TEMPERATURA=0.3
IA_MAX_TOKENS=700
IA_TIMEOUT_MS=25000

# --- Escaneo de facturas con IA (cámara) -----------------------------------
# Usa la MISMA clave y URL del asistente de soporte (IA_API_KEY e
# IA_BASE_URL), pero con su propio modelo: necesita uno con visión
# (imágenes y PDF). Sin IA_API_KEY, /api/ia/facturas responde 503 y el
# frontend usa el OCR local (Tesseract).
IA_MODELO_FACTURAS=gpt-4o-mini
IA_MAX_MB=8
IA_LIMITE_POR_HORA=30

# Límite de intentos fallidos de inicio de sesión por correo.
LOGIN_MAX_INTENTOS=10
LOGIN_VENTANA_MINUTOS=15
