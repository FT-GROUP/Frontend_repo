# Copia este archivo como ".env" y ajusta los valores.

NODE_ENV=development
PORT=3000

# Opcion A: variables sueltas (comodo en desarrollo local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ft_group

# Opcion B: cadena de conexion completa (si se define, tiene prioridad
# sobre las variables sueltas de arriba). Util para servicios cloud.
# DATABASE_URL=postgresql://usuario:password@host:5432/basededatos
# DATABASE_SSL=true

# Secreto para firmar los JWT. CAMBIAR en produccion por un valor
# largo y aleatorio (por ejemplo: openssl rand -base64 48).
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRATION=15m

# Origen(es) permitidos para CORS (usar "*" solo en desarrollo).
CORS_ORIGIN=http://localhost:5173
