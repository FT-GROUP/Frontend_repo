# Copia este archivo como ".env" y ajusta los valores.
NODE_ENV=development
PORT=4000

# Misma base de datos que el backend principal (el servicio SOLO lee).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ft_group
# DATABASE_URL=postgresql://usuario:password@host:5432/basededatos
# DATABASE_SSL=true

# DEBE ser exactamente el mismo JWT_SECRET del backend principal:
# asi el microservicio valida los tokens que ese backend emite.
JWT_SECRET=cambia-este-secreto-en-produccion

CORS_ORIGIN=http://localhost:5173
